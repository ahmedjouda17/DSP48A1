module TB #(
    // PARAMETERS 
    parameter A0REG = 0,
    parameter A1REG = 1,
    parameter B0REG = 0,
    parameter B1REG = 1,
    parameter CREG = 1,
    parameter DREG = 1,
    parameter MREG = 1,
    parameter PREG = 1,
    parameter CARRYINREG = 1,
    parameter CARRYOUTREG = 1,
    parameter OPMODEREG = 1,
    parameter CARRYINSEL = "OPMODE5",
    parameter B_INPUT = "DIRECT",
    parameter RSSTYPE = "SYNC"
)();
// MODULE REGISTER 
reg rst;  
reg CLK;
reg en;
// MODULE DSP48A1
reg [17:0]A,B,D;
reg [47:0]C;
reg CARRYIN;
reg [7:0]OPMODE;
reg [17:0]BCIN;
reg [47:0]PCIN;
wire [17:0]BCOUT;
wire [47:0]PCOUT;
wire [47:0]P;
wire [35:0]M;
wire CARRYOUT;
wire CARRYOUTF; 
// EXPECTED OUTPUTS 
reg [17:0]expected_BCOUT;
reg [47:0]expected_PCOUT;
reg [47:0]expected_P;
reg [35:0]expected_M;
reg expected_CARRYOUT;
reg expected_CARRYOUTF; 


// instantiation DSP48A1 
DSP48A1  #(A0REG,A1REG,B0REG,B1REG,CREG,DREG,MREG,PREG,CARRYINREG,CARRYOUTREG,OPMODEREG,CARRYINSEL,B_INPUT,RSSTYPE)
UUT (.A(A), .B(B), .C(C), .D(D),
     .CARRYIN(CARRYIN), .OPMODE(OPMODE),
     .BCIN(BCIN), .PCIN(PCIN), .CLK(CLK),
     .RSTA(rst), .RSTB(rst), .RSTC(rst), .RSTD(rst),
     .RSTM(rst), .RSTP(rst), .RSTCARRYIN(rst), .RSTOPMODE(rst),
     .CEA(en), .CEB(en), .CEC(en), .CED(en),
     .CEM(en), .CEP(en), .CECARRYIN(en), .CEOPMODE(en),
     .BCOUT(BCOUT), .PCOUT(PCOUT), .P(P), .M(M),
     .CARRYOUT(CARRYOUT), .CARRYOUTF(CARRYOUTF)
     );

     initial begin
        CLK=0;
        forever
        #1 CLK=~CLK;
     end

     //VERIFY RESET
     integer i; 
     initial begin
        rst = 1 ;
        en = 0;
        for (i = 0; i<15 ;i=i+1 ) begin
            A=$random;
            B=$random;
            D=$random;
            C=$random;
            CARRYIN=$random;
            OPMODE=$random;
            BCIN=$random;
            PCIN=$random;
            @(negedge CLK);
            if(BCOUT ==0 && PCOUT==0 && P==0 && M==0 && CARRYOUT==0 && CARRYOUTF==0)
            $display ("PASS");
            else 
            $display ("FAIL"); 
        end
        // delay for bug 
        repeat(4) @(negedge CLK);
// 2.2 Verify DSP Path 1
rst = 0;
en = 1;
@(negedge CLK);
A = 20; B = 10; C = 350; D = 25; OPMODE = 8'b11011101;
            for (i = 0; i<20 ;i=i+1 ) begin
            CARRYIN=$random; 
            BCIN=$random;
            PCIN=$random;
            repeat(4) @(negedge CLK);  
            expected_BCOUT     = 18'hf;
            expected_PCOUT     = 48'h32;
            expected_M         = 36'h12c;
            expected_P         = 48'h32;
            expected_CARRYOUT  = 1'b0;
            expected_CARRYOUTF = 1'b0;
            // self cheking
            if (BCOUT==expected_BCOUT && 
                PCOUT == expected_PCOUT &&
                M == expected_M &&
                P == expected_P && 
                CARRYOUT == expected_CARRYOUT &&
                CARRYOUTF == expected_CARRYOUTF)
                $display ("PASS");
            else 
            $display ("FAIL"); 
            end    

 // 2.3. Verify DSP Path 2
 A = 20; B = 10; C = 350;  D = 25; OPMODE = 8'b00010000;
             for (i = 0; i<20 ;i=i+1 ) begin
            CARRYIN=$random; 
            BCIN=$random;
            PCIN=$random;
            repeat(3) @(negedge CLK);  
            expected_BCOUT     = 18'h23;
            expected_PCOUT     = 48'h0;
            expected_M         = 36'h2bc;
            expected_P         = 48'h0;
            expected_CARRYOUT  = 1'b0;
            expected_CARRYOUTF = 1'b0;
             // self cheking
            if (BCOUT==expected_BCOUT && 
                PCOUT == expected_PCOUT &&
                M == expected_M &&
                P == expected_P && 
                CARRYOUT == expected_CARRYOUT &&
                CARRYOUTF == expected_CARRYOUTF)
                $display ("PASS");
            else 
            $display ("FAIL"); 
            end    

// 2.4. Verify DSP Path 3
A = 20; B = 10; C = 350; D = 25; OPMODE = 8'b00001010;
           for (i = 0; i<20 ;i=i+1 ) begin
            CARRYIN=$random; 
            BCIN=$random;
            PCIN=$random;
            repeat(3) @(negedge CLK);  
            expected_BCOUT     = 18'ha;
            expected_PCOUT     = 48'h0;
            expected_M         = 36'hc8;
            expected_P         = 48'h0;
            expected_CARRYOUT  = 1'b0;
            expected_CARRYOUTF = 1'b0;
             // self cheking
            if (BCOUT==expected_BCOUT && 
                PCOUT == expected_PCOUT &&
                M == expected_M &&
                P == expected_P && 
                CARRYOUT == expected_CARRYOUT &&
                CARRYOUTF == expected_CARRYOUTF)
                $display ("PASS");
            else 
            $display ("FAIL"); 
            end    

// 2.5. Verify DSP Path 4 
A = 5; B = 6; C = 350; D = 25; OPMODE = 8'b10100111; PCIN = 3000;
           for (i = 0; i<20 ;i=i+1 ) begin
            CARRYIN=$random; 
            BCIN=$random;
            repeat(3) @(negedge CLK);  
            expected_BCOUT     = 18'h6;
            expected_PCOUT     = 48'hfe6fffec0bb1;
            expected_M         = 36'h1e;
            expected_P         = 48'hfe6fffec0bb1;
            expected_CARRYOUT  = 1'b1;
            expected_CARRYOUTF = 1'b1;
             // self cheking
            if (BCOUT==expected_BCOUT && 
                PCOUT == expected_PCOUT &&
                M == expected_M &&
                P == expected_P && 
                CARRYOUT == expected_CARRYOUT &&
                CARRYOUTF == expected_CARRYOUTF)
                $display ("PASS");
            else 
            $display ("FAIL"); 
            end    
#10; 
$stop;
     end
initial begin
    $monitor(" A=%d B=%d C=%d D=%d OPMODE=%b | BCOUT=%h PCOUT=%h P=%h M=%h CARRYOUT=%b CARRYOUTF=%b",
               A, B, C, D, OPMODE,
              BCOUT, PCOUT, P, M, CARRYOUT, CARRYOUTF);
end
endmodule //TB